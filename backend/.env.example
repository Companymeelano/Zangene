APP_NAME="ASIYE STORE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://asiyestore.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asiye_store_prod
DB_USERNAME=asiye_user
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Payment Gateways (Server-Side Only — Never expose to Frontend/APK)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL="${APP_URL}/api/v1/payments/callback/zarinpal"

# Installment Providers (BNPL)
SNAPP_PAY_CLIENT_ID=
SNAPP_PAY_CLIENT_SECRET=
SNAPP_PAY_WEBHOOK_SECRET=
TARA_API_KEY=
TARA_WEBHOOK_SECRET=

# SMS & Push Notifications
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=asiye-verify
FCM_PROJECT_ID=asiye-store-luxury

# Store Policies
FREE_SHIPPING_THRESHOLD_TOMAN=3000000
OTP_EXPIRES_SECONDS=120
OTP_MAX_ATTEMPTS=5
